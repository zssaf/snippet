		  "int main(){",
		  "    ll N,Q;",
		  "    cin >> N >> Q;",
		  "    vector<ll> A(N-1),B(N-1);",
		  "    HLDecomposition hld;",
		  "    hld.init(N);",
		  "    rep(i,N-1){",
		  "        ll a,b;",
		  "        cin >> a >> b;",
		  "        a--;b--;",
		  "        hld.add(a,b);",
		  "        A[i] = a; B[i] = b;",
		  "    }",
		  "    hld.build(0);",
		  "    PR(hld.heavy, N);",
		  "    PR(hld.head, N);",
		  "    PR(hld.vid, N);",
		  "    map<ll,ll> mp;",
		  "    lazy_segtree<ll,op,e,F,mapping,composition,id> seg(vector<ll>(N,(0)));",
		  "    rep(i,Q){",
		  "        ll u,v,c;",
		  "        cin >> u >> v >> c;",
		  "        u--;v--;",
		  "        ll lc = hld.lca(u, v);",
		  "        ll tmp = seg.get(hld.vid[lc]);//共通祖先ノードの一個上の親ノードとの辺も巻き込んでしまうため、退避させておく。",
		  "        // cout << tmp << endl;",
		  "        hld.foreach(u, v, [&](ll a, ll b){",
		  "            if(i == Q-1){",
		  "                cout << \"a,b \" << a << \" \" << b << endl;",
		  "            }",
		  "            seg.apply(a, b+1, c);",
		  "        });",
		  "        seg.set(hld.vid[lc], tmp);//共通祖先ノードの一個上の親ノードとの辺も巻き込んでしまったため、戻しておく。",
		  "    }",
		  "    rep(i,N-1){",
		  "        ll a = A[i];",
		  "        ll b = B[i];",
		  "        if(hld.depth[a] > hld.depth[b]) swap(a, b);",
		  "        mp[b] = i;",
		  "    }",
		  "    vector<ll> ans(N);",
		  "    REP(i, 1, N) {",
		  "        ll c = seg.get(hld.vid[i]);",
		  "        ans[mp[i]] = c;",
		  "    }",
		  "    rep(i,N-1){",
		  "        cout << ans[i] << endl;",
		  "    }",
		  "}",
