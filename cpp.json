		  "// {g,x,y}: ax+by=g",
		  "g = gcd(a,b)",
		  "// xやyが負になることもある",
		  "tuple<ll,ll,ll> extgcd(ll a, ll b) {",
		  "  if (b == 0) return {a,1,0};",
		  "  ll g, x, y;",
		  "  tie(g,x,y) = extgcd(b, a%b);",
		  "  return {g, y, x-a/b*y};",
		  "}",
		  "{",
