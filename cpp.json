		  "    for (ll i = 2; i <= n; ++i) {",
		  "      if (f[i]) continue;",
		  "      primes.push_back(i);",
		  "      f[i] = i;",
		  "      for (ll j = i*i; j <= n; j += i) {",
		  "        if (!f[j]) f[j] = i;",
		  "      }",
		  "    }",
		  "  }",
		  "  bool isPrime(int x) { return f[x] == x;}",
		  "  vector<int> factorList(int x) {",
		  "    vector<int> res;",
		  "    while (x != 1) {",
		  "      res.push_back(f[x]);",
