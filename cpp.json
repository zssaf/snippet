	  "factorize": {
		"prefix": "factorize",
		"body": [
		  "vector<pair<ll,int>> factorize(ll n){",
		  "    vector<pair<ll,int>> res;",
		  "    for(ll i=2; i*i <=n;i++){",
		  "        if(n%i)continue;",
		  "        res.emplace_back(i,0);",
		  "        while(n % i == 0){",
		  "            n /= i;",
		  "            res.back().second++;",
		  "        }",
		  "    }",
		  "    if(n != 1)res.emplace_back(n,1);",
		  "    return res;",
		  "}"
		],
