		"body": [
		  "    ll N;",
		  "    cin >> N;",
		  "    vector<vector<Pll>> G(N);",
		  "    rep(i,N-1){",
		  "        ll u,v,w;",
		  "        cin >> u >> v >> w;",
		  "        u--;v--;",
		  "        G[u].push_back({w,v});",
		  "        G[v].push_back({w,u});",
		  "    }",
		  "    map<Pll,ll> np;",
		  "    function<ll(ll,ll)> dfs = [&](ll v, ll p){",
		  "        ll ret = 1;",
		  "        for(auto& pp:G[v]){",
		  "            ll u = pp.se;",
		  "            ll w = pp.fi;",
		  "            if(u==p)continue;",
		  "            ret += dfs(u,v); // 関数の入力はmapの入力順と逆なことに注意",
		  "        }",
		  "        return np[{p,v}] = ret; // p->vなことに注意",
		  "    };",
		  "    dfs(0,-1);",
		  "    function<void(ll,ll)> bfs = [&](ll v, ll p){",
		  "        ll sum = 1;",
		  "        for(auto& pp:G[v]){",
		  "            ll u = pp.se;",
		  "            sum += np[{v,u}];",
		  "        }",
		  "        for(auto& pp:G[v]){",
		  "            ll u = pp.se;",
		  "            if(u == p) continue;",
		  "            np[{u,v}] = sum - np[{v,u}];",
		  "            bfs(u,v);",
		  "        }",
		  "    };",
		  "    bfs(0,-1);"
