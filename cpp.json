		"body": [
		  "    ll N;",
		  "    cin >> N;",
		  "    vector<ll> A(N);",
		  "    rep(i,N) cin >> A[i];",
		  "    map<ll,ll> mp;",
		  "    rep(i,N){",
		  "        mp[A[i]] = 1;",
		  "    }",
		  "    ll id = 0;",
		  "    {",
		  "        for(auto [a,b]:mp){",
		  "            mp[a] = id;",
		  "            id++;",
		  "        }",
		  "        rep(i,N) A[i] = mp[A[i]];",
		  "    }",
		  "    auto func = [&](){",
		  "        // dp[i]: iが最後のLIS長",
		  "        vector<ll> dp(N);",
		  "        segtree<ll,op,e> seg(N);",
		  "        rep(i,N){",
		  "            dp[i] = seg.prod(0,A[i])+1;",
